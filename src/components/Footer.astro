---
/**
 * Site footer: logo, page links, contact, legal.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contact, footerLinks, social, site, PRIMARY_CTA } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label={`${site.name} home`}><Logo height={96} eager={false} /></a>
        <p class="site-footer__strap">{site.blurb}</p>
        {
          (social.facebook || social.instagram) && (
            <div class="site-footer__social">
              {social.facebook && (
                <a href={social.facebook} target="_blank" rel="noopener" aria-label={`${site.name} on Facebook`}>
                  <Icon name="facebook" size={20} />
                </a>
              )}
              {social.instagram && (
                <a href={social.instagram} target="_blank" rel="noopener" aria-label={`${site.name} on Instagram`}>
                  <Icon name="instagram" size={20} />
                </a>
              )}
            </div>
          )
        }
      </div>

      <nav class="site-footer__col" aria-label="Explore">
        <h2 class="site-footer__heading">Explore</h2>
        <ul role="list">
          {footerLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Visit the Shack</h2>
        <ul role="list">
          <li>
            <a class="site-footer__contact" href={contact.phoneHref}><Icon name="phone" size={17} />{contact.phoneDisplay}</a>
          </li>
          <li>
            <a class="site-footer__contact" href={contact.directionsHref} target="_blank" rel="noopener"><Icon name="map-pin" size={17} /><span>{contact.street}<br />{contact.city}, {contact.region} {contact.postcode}</span></a>
          </li>
          <li class="site-footer__area"><Icon name="clock" size={17} />{contact.hours}</li>
          <li><a class="site-footer__order" href={PRIMARY_CTA.href}>{PRIMARY_CTA.label} <Icon name="arrow-right" size={16} /></a></li>
        </ul>
      </div>
    </div>

    <hr class="hairline" />

    <div class="site-footer__bottom">
      <p>© {year} {site.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    padding-block: clamp(3.5rem, 2rem + 6vw, 6rem) 2rem;
    background: linear-gradient(180deg, var(--harbor-900), var(--deep));
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .site-footer__top {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 4rem);
  }

  .site-footer__brand {
    grid-column: 1 / -1;
  }

  .site-footer__strap {
    margin-top: 1.25rem;
    max-width: 26rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .site-footer__social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .site-footer__social a:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .site-footer__heading {
    margin-bottom: 1.1rem;
    font-family: var(--font-body);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    color: var(--text);
  }

  .site-footer__col ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }

  .site-footer__col a,
  .site-footer__area {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    text-decoration: none;
    color: var(--text-muted);
    transition: color var(--dur-1) ease;
  }

  .site-footer__col a:hover {
    color: var(--text);
  }

  .site-footer__col :global(.icon) {
    color: var(--accent);
  }

  /* Break long addresses only at the @ sign, never mid-word. */
  .site-footer__contact {
    overflow-wrap: break-word;
  }

  .site-footer__col a.site-footer__order {
    margin-top: 0.4rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }




  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
  }

  .site-footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .site-footer__legal a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .site-footer__marks {
    margin-top: 0.75rem;
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--text-faint);
    max-width: 60rem;
  }

  @media (min-width: 48em) {
    .site-footer__top {
      grid-template-columns: 1.4fr 1fr 1.2fr;
    }
    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
