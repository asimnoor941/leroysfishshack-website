---
/**
 * A short, silent, looping clip of a real delivery. The file is fetched only
 * when the clip scrolls into view, plays while visible and pauses when it
 * leaves. Visitors who prefer reduced motion, or have data saver on, get the
 * poster and a play button instead of autoplay. A pause button is always
 * available.
 *
 *   import poster from '../assets/posters/intro.jpg';
 *   <VideoClip src="/video/intro.mp4" poster={poster} label="Describe what the video shows" />
 *
 * Clips available: /video/hose-run.mp4 (39 s, 960x540), /video/handoff.mp4 (19 s, 1280x720).
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  src: string;
  poster: ImageMetadata;
  /** Describes what the clip shows, for screen readers. */
  label: string;
  ratio?: string;
  caption?: string;
  class?: string;
}

const { src, poster, label, ratio = '16 / 9', caption, class: className } = Astro.props;
const posterImage = await getImage({ src: poster, width: Math.min(1280, poster.width), format: 'webp', quality: 72 });
---

<figure class:list={['clip', 'frame', className]} data-reveal>
  <div class="clip__media" style={`aspect-ratio:${ratio}`}>
    <video
      class="clip__video"
      data-clip
      data-src={src}
      poster={posterImage.src}
      muted
      loop
      playsinline
      preload="none"
      aria-label={label}
    >
    </video>
    <button class="clip__toggle" type="button" data-clip-toggle aria-label="Play video" aria-pressed="false">
      <span class="clip__icon clip__icon--play"><Icon name="play" size={18} /></span>
      <span class="clip__icon clip__icon--pause" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
      </span>
    </button>
  </div>
  {caption && <figcaption class="clip__caption">{caption}</figcaption>}
</figure>

<style>
  .clip {
    margin: 0;
  }

  .clip__media {
    position: relative;
    background: var(--ink);
  }

  .clip__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .clip__toggle {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    color: var(--white);
    background: rgb(8 21 23 / 0.62);
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    backdrop-filter: blur(8px);
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .clip__toggle:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .clip__icon {
    display: grid;
    place-items: center;
  }

  .clip__icon--pause,
  .clip__toggle[aria-pressed='true'] .clip__icon--play {
    display: none;
  }

  .clip__toggle[aria-pressed='true'] .clip__icon--pause {
    display: grid;
  }

  .clip__caption {
    padding: 0.85rem 1.1rem 1rem;
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  const autoplay = !reduced && !saveData;

  document.querySelectorAll<HTMLVideoElement>('video[data-clip]').forEach((video) => {
    const toggle = video.parentElement?.querySelector<HTMLButtonElement>('[data-clip-toggle]');
    let userPaused = false;

    const ensureSource = () => {
      if (!video.src && video.dataset.src) video.src = video.dataset.src;
    };
    const sync = () => {
      const playing = !video.paused;
      toggle?.setAttribute('aria-pressed', String(playing));
      toggle?.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
    };
    const play = () => {
      ensureSource();
      video.play().catch(() => {
        /* autoplay refused: the play button remains */
      });
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    toggle?.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        play();
      } else {
        userPaused = true;
        video.pause();
      }
    });

    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (autoplay && !userPaused) play();
          } else if (!video.paused) {
            video.pause();
          }
        }
      },
      { threshold: 0.35 },
    ).observe(video);
  });
</script>
