---
/**
 * A responsive photo (AVIF and WebP generated at build) with optional frame,
 * fixed aspect ratio and caption. Always import the image from src/assets.
 *
 *   import team from '../assets/photos/team.jpg';
 *   <Photo src={team} alt="Describe the photo" ratio="4 / 3" framed />
 *
 * sizes     The CSS width the photo occupies. Default suits a half-width column.
 *           Use "100vw" for full-bleed photos.
 * ratio     CSS aspect-ratio ("4 / 3", "16 / 9", "1"). The photo is cropped to fit.
 * position  object-position for the crop, e.g. "50% 20%".
 * eager     true for a photo that is visible when the page first loads.
 * reveal    false to skip the scroll-in animation.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  ratio?: string;
  position?: string;
  eager?: boolean;
  framed?: boolean;
  reveal?: boolean;
  caption?: string;
  class?: string;
}

const {
  src,
  alt,
  sizes = '(min-width: 60em) 46vw, 100vw',
  widths = [480, 720, 960, 1280, 1600, 1920],
  ratio,
  position = '50% 50%',
  eager = false,
  framed = false,
  reveal = true,
  caption,
  class: className,
} = Astro.props;

const usable = widths.filter((w) => w <= src.width);
if (!usable.length || usable[usable.length - 1] < Math.min(src.width, 1920)) usable.push(Math.min(src.width, 2560));
---

<figure class:list={['photo', { frame: framed, 'photo--ratio': ratio }, className]} data-reveal={reveal ? '' : undefined}>
  <div class="photo__media" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={usable}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      style={`object-position:${position}`}
    />
  </div>
  {caption && <figcaption class="photo__caption">{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
  }

  .photo__media {
    overflow: hidden;
    border-radius: inherit;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .photo--ratio :global(picture),
  .photo--ratio :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo--ratio :global(picture) {
    display: block;
  }

  .photo__caption {
    padding: 0.8rem 0.2rem 0;
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .photo.frame .photo__caption {
    padding: 0.8rem 1.1rem 1rem;
  }
</style>
