    '<path d="M4.500 21V5.500L12 3v18"/><path d="M12 9h7.500v12"/><path d="M3 21h18"/><path d="M7.500 9v0"/><path d="M7.500 13v0"/><path d="M7.500 17v0"/><path d="M15.500 13v0"/><path d="M15.500 17v0"/>',
