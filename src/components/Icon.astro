  drop: '<path d="M12 3s6.500 6.700 6.500 11.300a6.500 6.500 0 0 1-13 0C5.500 9.700 12 3 12 3Z"/><path d="M9.500 14.500a2.700 2.700 0 0 0 2.500 2.500"/>',
