---
/**
 * The Leroy's Fish Shack logo (shack on the dock, mint roof).
 *
 * tone="light"  sand ink for dark backgrounds (default)
 * tone="ink"    the original black ink for light backgrounds
 * height        rendered height in CSS pixels
 */
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/logo-light.png';
import logoInk from '../assets/brand/logo.png';
import { site } from '../data/site';

interface Props {
  tone?: 'light' | 'ink';
  height?: number;
  eager?: boolean;
  class?: string;
}

const { tone = 'light', height = 44, eager = true, class: className } = Astro.props;
const src = tone === 'ink' ? logoInk : logoLight;
const width = Math.round((height * src.width) / src.height);
---

<Image
  class:list={['logo', className]}
  src={src}
  alt={site.name}
  width={width}
  height={height}
  densities={[1, 2, 3]}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>

<style>
  :global(a:has(> .logo)) {
    text-decoration: none;
    display: inline-flex;
  }
  .logo {
    display: block;
    height: auto;
    max-width: 100%;
  }
</style>
