---
/**
 * One headline number with a label.
 *
 *   <Stat value="350" unit="ft" label="Hose Reach" />
 *   <Stat value="Millions" label="Of Gallons Delivered" />
 *   <Stat value="$0" label="Delivery Fee" note="No hidden charges." />
 *
 * When `value` is a plain number (optionally with commas, + or $), it counts up
 * the first time it scrolls into view. Words ("Millions", "COI") are shown as-is.
 */
interface Props {
  value: string;
  unit?: string;
  label: string;
  note?: string;
  size?: 'md' | 'lg';
  class?: string;
}

const { value, unit, label, note, size = 'md', class: className } = Astro.props;
const numeric = /^[$]?[\d,]+(\.\d+)?[+%]?$/.test(value.trim());
---

<div class:list={['stat', `stat--${size}`, className]} data-reveal>
  <p class="stat__value numeral">
    <span data-count={numeric ? value : undefined}>{value}</span>{unit && <span class="stat__unit">{unit}</span>}
  </p>
  <p class="stat__label">{label}</p>
  {note && <p class="stat__note">{note}</p>}
</div>

<style>
  .stat {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .stat__value {
    font-size: var(--step-4);
    color: var(--text);
    white-space: nowrap;
  }

  .stat--lg .stat__value {
    font-size: var(--step-5);
  }

  .stat__unit {
    margin-left: 0.14em;
    font-size: 0.5em;
    color: var(--accent);
  }

  .stat__label {
    margin-top: 0.7rem;
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stat__note {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: 26em;
  }
</style>

<script>
  // Count numeric stats up from zero when they first become visible.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('[data-count]');

  function animate(el: HTMLElement): void {
    const raw = el.dataset.count ?? '';
    const match = raw.match(/^([$]?)([\d,]+(?:\.\d+)?)([+%]?)$/);
    if (!match) return;
    const [, prefix, digits, suffix] = match;
    const end = Number(digits.replace(/,/g, ''));
    const decimals = digits.includes('.') ? digits.split('.')[1].length : 0;
    const format = (n: number) =>
      prefix + n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
    if (end === 0) return;
    const duration = 1400;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - p, 4);
      el.textContent = format(end * eased);
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = raw;
    };
    requestAnimationFrame(tick);
  }

  if (!reduced && 'IntersectionObserver' in window && targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          animate(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
